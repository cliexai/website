# ─────────────────────────────────────────────────────────────
# ClieX AI – Environment Variables Example
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# Supabase (public – safe in client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# reCAPTCHA v2 site key (optional – public)
VITE_RECAPTCHA_SITE_KEY=your-site-key

# Comma-separated admin emails for dashboard access
VITE_ADMIN_EMAILS=admin@example.com

# ─────────────────────────────────────────────────────────────
# Server-side only (never VITE_ prefix — NOT exposed to client)
# Set these on Vercel / Supabase Edge Functions directly.
# ─────────────────────────────────────────────────────────────

# Retell AI
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-retell-agent-id

# Resend (email notifications — for Supabase Edge Functions)
RESEND_API_KEY=your-resend-api-key
